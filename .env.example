# Optional defaults for the OpenAI-compatible provider. Everything also works
# without these: the app falls back to the built-in mock streaming backend.
# WARNING: anything prefixed VITE_ is bundled into the client. Never put a
# real secret here for a public deployment; enter keys in the Settings panel instead.
VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_MODEL=gpt-4o-mini
# VITE_LLM_API_KEY=
